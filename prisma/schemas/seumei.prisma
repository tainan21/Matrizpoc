// ============================================================================
// Matriz — Seumei Prisma Schema
// ----------------------------------------------------------------------------
// Authority: Seumei app owns the domain of establishments (restaurants,
// venues, operations units), their profiles, order drafts and preferences.
// No cross-schema FKs — cross-app references flow through ExternalLink
// records in core.prisma (L1).
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/seumei"
}

datasource db {
  provider = "postgresql"
  url      = env("SEUMEI_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Establishment — the core operation entity in Seumei.
// ---------------------------------------------------------------------------
model Establishment {
  id          String              @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  type        EstablishmentType
  status      EstablishmentStatus @default(ACTIVE)
  addressLine String?
  city        String
  country     String              @default("BR")
  phone       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  profile      EstablishmentProfile?
  orderDrafts  OrderDraft[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, type])
  @@map("establishments")
}

enum EstablishmentType {
  RESTAURANT
  BAR
  CAFE
  VENUE
  FOODTRUCK
  OTHER
}

enum EstablishmentStatus {
  ACTIVE
  PAUSED
  CLOSED
}

// ---------------------------------------------------------------------------
// EstablishmentProfile — extended branding and operational profile.
// ---------------------------------------------------------------------------
model EstablishmentProfile {
  id              String   @id @default(cuid())
  establishmentId String   @unique
  tenantId        String
  displayName     String
  description     String?
  capacity        Int?
  openingHours    Json?
  tags            String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("establishment_profiles")
}

// ---------------------------------------------------------------------------
// OrderDraft — optional mock of commercial orders being prepared for an
// establishment. Reserved for future real persistence.
// ---------------------------------------------------------------------------
model OrderDraft {
  id               String           @id @default(cuid())
  tenantId         String
  establishmentId  String
  reference        String
  status           OrderDraftStatus @default(DRAFT)
  totalCents       Int              @default(0)
  currency         String           @default("BRL")
  items            Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([establishmentId])
  @@map("order_drafts")
}

enum OrderDraftStatus {
  DRAFT
  READY
  SUBMITTED
  CANCELLED
}

// ---------------------------------------------------------------------------
// SeumeiPreference — tenant-scoped preferences for the Seumei app.
// ---------------------------------------------------------------------------
model SeumeiPreference {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  defaultType         String?
  operationsModel     String?
  preferredCurrency   String   @default("BRL")
  enableDeliveryZones Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("seumei_preferences")
}

// ---------------------------------------------------------------------------
// Company — customer business and the Seumei-side projection of one tenant.
// ---------------------------------------------------------------------------
model Company {
  id                String               @id @default(cuid())
  tenantId          String               @unique
  name              String
  slug              String               @unique
  createdByUserId   String
  idempotencyKey    String
  status            CompanyStatus        @default(PROVISIONING)
  operationType     CompanyOperationType?
  city              String?
  country           String               @default("BR")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  onboarding CompanyOnboarding?

  @@unique([createdByUserId, idempotencyKey])
  @@index([createdByUserId, status])
  @@map("companies")
}

enum CompanyStatus {
  PROVISIONING
  ONBOARDING
  ACTIVE
  PROVISIONING_FAILED
}

enum CompanyOperationType {
  PHYSICAL_STORE
  ONLINE_STORE
  SERVICE
  HYBRID
}

// ---------------------------------------------------------------------------
// CompanyOnboarding — resumable tenant-scoped setup for one company.
// ---------------------------------------------------------------------------
model CompanyOnboarding {
  id                 String                   @id @default(cuid())
  companyId          String                   @unique
  tenantId           String                   @unique
  currentStep        CompanyOnboardingStep    @default(IDENTITY)
  version            Int                      @default(1)
  draftName          String
  draftSlug          String
  draftOperationType CompanyOperationType?
  draftCity          String?
  draftCountry       String                   @default("BR")
  draftCurrency      String                   @default("BRL")
  completedSteps     String[]
  startedAt          DateTime                 @default(now())
  completedAt        DateTime?
  updatedAt          DateTime                 @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId, currentStep])
  @@map("company_onboarding")
}

enum CompanyOnboardingStep {
  IDENTITY
  OPERATION
  PREFERENCES
  REVIEW
  COMPLETED
}
