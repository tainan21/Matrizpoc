// ============================================================================
// Matriz — Contracts Prisma Schema
// ----------------------------------------------------------------------------
// Authority: Contracts app owns legal/commercial contract generation and
// lifecycle. It consumes context from Spot (gigs) and Seumei (establishments)
// via DTOs + ExternalLink records in core.prisma (L1, L3).
//
// Contracts NEVER store native pointers to Gig.id or Establishment.id.
// Those connections are modeled as ExternalLink rows in the core schema.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/contracts"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTRACTS_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Contract — the root aggregate of the Contracts domain.
// ---------------------------------------------------------------------------
model Contract {
  id               String          @id @default(cuid())
  tenantId         String
  reference        String
  title            String
  status           ContractStatus  @default(DRAFT)
  originApp        String
  originEntityType String
  originEntityId   String
  templateId       String?
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  currency         String          @default("BRL")
  totalValueCents  Int             @default(0)
  createdBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  template  ContractTemplate? @relation(fields: [templateId], references: [id])
  parties   ContractParty[]
  versions  ContractVersion[]
  events    ContractEvent[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, originApp])
  @@map("contracts")
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  ACTIVE
  FULFILLED
  CANCELLED
  EXPIRED
}

// ---------------------------------------------------------------------------
// ContractParty — signatories and roles bound to a contract.
// ---------------------------------------------------------------------------
model ContractParty {
  id          String            @id @default(cuid())
  tenantId    String
  contractId  String
  role        ContractPartyRole
  displayName String
  legalName   String?
  document    String?
  email       String?
  signedAt    DateTime?
  createdAt   DateTime          @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId])
  @@map("contract_parties")
}

enum ContractPartyRole {
  ARTIST
  BAND
  ESTABLISHMENT
  PROMOTER
  PLATFORM
  OTHER
}

// ---------------------------------------------------------------------------
// ContractVersion — immutable snapshot of a contract body per revision.
// ---------------------------------------------------------------------------
model ContractVersion {
  id          String   @id @default(cuid())
  tenantId    String
  contractId  String
  versionNo   Int
  bodyMarkdown String
  hash        String
  createdBy   String?
  createdAt   DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, versionNo])
  @@index([tenantId])
  @@map("contract_versions")
}

// ---------------------------------------------------------------------------
// ContractEvent — lifecycle audit log for each contract.
// ---------------------------------------------------------------------------
model ContractEvent {
  id         String   @id @default(cuid())
  tenantId   String
  contractId String
  eventName  String
  payload    Json?
  actorId    String?
  occurredAt DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId, occurredAt])
  @@map("contract_events")
}

// ---------------------------------------------------------------------------
// ContractTemplate — reusable template driving contract creation.
// ---------------------------------------------------------------------------
model ContractTemplate {
  id           String   @id @default(cuid())
  tenantId     String
  slug         String
  title        String
  description  String?
  bodyMarkdown String
  variables    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contracts Contract[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("contract_templates")
}
