// ============================================================================
// Matriz — Core Prisma Schema
// ----------------------------------------------------------------------------
// Authority: this schema models the shared/core concerns of the Matriz
// ecosystem (tenants, users, memberships, app registrations, external links,
// onboarding progress, optional sessions and telemetry).
//
// Architectural Laws in force:
//   L1 — schema per app is the V1 unit of isolation (core + 4 app schemas).
//   L5 — repositories use these shapes as the future real persistence layer.
//   L7 — changes to fields must be versioned in lockstep with public DTOs.
//
// V1 note: NO database is connected. This schema exists to be validated and
// to mirror the future real architecture. Field types, enums and relations
// are chosen to be realistic without over-committing to implementation
// details we do not yet need.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/core"
}

datasource db {
  provider = "postgresql"
  url      = env("CORE_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant — the isolation boundary for every customer of the Matriz platform.
// ---------------------------------------------------------------------------
model Tenant {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  brandColor  String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships         TenantMembership[]
  appGrants           AppGrant[]
  identityAuditEvents IdentityAuditEvent[]
  appRegistrations    AppRegistration[]
  externalLinks       ExternalLink[]
  onboardingProgress  OnboardingProgress[]
  appSessions         AppSession[]
  telemetryRecords    TelemetryRecord[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// User — platform-level GLOBAL identity. Belongs to multiple tenants through
// memberships. No direct tenantId FK; isolation happens at Membership level.
// ---------------------------------------------------------------------------
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String
  avatarUrl   String?
  locale      String?  // e.g., "pt-BR", "en-US" — future cross-app UI locale
  timezone    String?  // e.g., "America/Sao_Paulo" — for scheduling/timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships         TenantMembership[]
  invitedMemberships  TenantMembership[] @relation("MembershipInvitedBy")
  revokedMemberships  TenantMembership[] @relation("MembershipRevokedBy")
  grantedAppGrants    AppGrant[]          @relation("AppGrantGrantedBy")
  revokedAppGrants    AppGrant[]          @relation("AppGrantRevokedBy")
  revokedOidcClients  OidcClient[]         @relation("OidcClientRevokedBy")
  identityAuditEvents IdentityAuditEvent[] @relation("IdentityAuditActor")
  authAccounts        AuthAccount[]
  appSessions         AppSession[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Membership — user ↔ tenant ↔ app with role. One user may be active on
// several apps within one tenant. This is THE JOIN between global User and
// scoped tenants.
// ---------------------------------------------------------------------------
model TenantMembership {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String
  tenantRoles      String[]
  invitedAt        DateTime?
  invitedByUserId  String?
  acceptedAt       DateTime?
  lastActiveAt     DateTime?
  revokedAt        DateTime?
  revokedByUserId  String?
  revocationReason String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?      @relation("MembershipInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  revokedBy User?      @relation("MembershipRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  appGrants AppGrant[]

  @@unique([tenantId, userId])
  @@index([tenantId, revokedAt])
  @@index([userId, revokedAt])
  @@map("tenant_memberships")
}

model AppGrant {
  id               String   @id @default(cuid())
  tenantId         String
  membershipId     String
  appId            String
  appRoles         String[]
  capabilities     String[]
  grantedAt        DateTime @default(now())
  grantedByUserId  String?
  revokedAt        DateTime?
  revokedByUserId  String?
  revocationReason String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  grantedBy  User?            @relation("AppGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  revokedBy  User?            @relation("AppGrantRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([membershipId, appId])
  @@index([tenantId, appId, revokedAt])
  @@index([membershipId, revokedAt])
  @@map("app_grants")
}

model OidcClient {
  id                      String   @id @default(cuid())
  clientId                String   @unique
  name                    String
  redirectUris            String[]
  postLogoutRedirectUris  String[]
  grantTypes              String[]
  responseTypes           String[]
  tokenEndpointAuthMethod String   @default("none")
  enabled                 Boolean  @default(true)
  revokedAt               DateTime?
  revokedByUserId         String?
  revocationReason        String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  revokedBy User? @relation("OidcClientRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([enabled, revokedAt])
  @@map("oidc_clients")
}

model IdentityAuditEvent {
  id          String   @id @default(cuid())
  tenantId    String?
  actorUserId String?
  eventType   String
  subjectType String
  subjectId   String
  metadata    Json?
  occurredAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation("IdentityAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([subjectType, subjectId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("identity_audit_events")
}

// ---------------------------------------------------------------------------
// AppRegistration — records which apps are enabled for a tenant. Drives the
// Hub catalog and feature-flags (L10) lookups.
// ---------------------------------------------------------------------------
model AppRegistration {
  id              String   @id @default(cuid())
  tenantId        String
  appId           String
  manifestVersion String
  contractVersion String   @default("v1")
  enabled         Boolean  @default(true)
  enabledAt       DateTime @default(now())
  disabledAt      DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appId])
  @@index([appId])
  @@map("app_registrations")
}

// ---------------------------------------------------------------------------
// ExternalLink — the canonical shape that lets any entity in any app point
// at any other entity in any other app without direct FK coupling.
// Mirrors packages/integration/external-links types exactly.
// ---------------------------------------------------------------------------
model ExternalLink {
  id                 String   @id @default(cuid())
  tenantId           String
  localApp           String
  localEntityType    String
  localEntityId      String
  externalApp        String
  externalEntityType String
  externalEntityId   String
  relationType       String
  snapshot           Json?
  createdAt          DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, localApp, localEntityType, localEntityId])
  @@index([tenantId, externalApp, externalEntityType, externalEntityId])
  @@map("external_links")
}

// ---------------------------------------------------------------------------
// OnboardingProgress — tracks the shared onboarding flow per tenant per app.
// Used by Hub to show "onboarding status by tenant/app".
// ---------------------------------------------------------------------------
model OnboardingProgress {
  id             String             @id @default(cuid())
  tenantId       String
  appId          String
  status         OnboardingStatus   @default(NOT_STARTED)
  currentStepId  String?
  sharedPayload  Json?
  appPayload     Json?
  completedSteps String[]
  startedAt      DateTime?
  completedAt    DateTime?
  updatedAt      DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appId])
  @@index([tenantId])
  @@map("onboarding_progress")
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

// ---------------------------------------------------------------------------
// AuthAccount — Links a User to an authentication provider (OTP, Magic Link,
// OAuth, password, etc). One user can have multiple accounts (different
// providers or sub-identities). This is the JOIN for identity linking.
// ---------------------------------------------------------------------------
model AuthAccount {
  id              String       @id @default(cuid())
  userId          String
  provider        AuthProvider
  providerSubject String       // email hash for OTP/Magic Link, OAuth sub, etc.
  email           String?
  emailVerifiedAt DateTime?
  metadata        Json?        // provider-specific data (OAuth tokens, etc.)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([email])
  @@map("auth_accounts")
}

enum AuthProvider {
  MAGIC_LINK
  OTP
  OAUTH_GOOGLE
  OAUTH_GITHUB
  PASSWORD
}

// ---------------------------------------------------------------------------
// AuthVerificationChallenge — Persistent OTP/magic-link challenges.
// Replaces in-memory Map<token, ...> from V1.1 strategies.
// ---------------------------------------------------------------------------
model AuthVerificationChallenge {
  id          String              @id @default(cuid())
  kind        AuthChallengeKind
  email       String
  codeHash    String              // bcrypt(otp) or hash(magic-link-token)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime            @default(now())
  ipHash      String?
  userAgent   String?

  @@index([email, kind])
  @@index([expiresAt])
  @@map("auth_verification_challenges")
}

enum AuthChallengeKind {
  OTP
  MAGIC_LINK
}

// ---------------------------------------------------------------------------
// AppSession — Real server-side session. Replaces SharedSession with full
// auth lifecycle: token hash, expiry, revocation, last-seen tracking.
// ---------------------------------------------------------------------------
model AppSession {
  id         String    @id @default(cuid())
  userId     String
  tenantId   String
  appId      String    // app where session was issued (spot, seumei, contracts, ...)
  strategyId String    // "magic-link", "otp", "oauth-google", ...
  tokenHash  String    @unique  // SHA-256(session cookie token)
  issuedAt   DateTime
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  ipHash     String?
  userAgent  String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId, appId])
  @@index([expiresAt])
  @@map("app_sessions")
}

// ---------------------------------------------------------------------------
// TelemetryRecord — envelope for every telemetry event emitted by any app.
// Shape mirrors TelemetryEventDTO v1. V1.3 adds `category` for Institutional
// Telemetry Classification.
// ---------------------------------------------------------------------------
model TelemetryRecord {
  id         String   @id @default(cuid())
  tenantId   String
  appId      String
  eventName  String
  eventVersion String @default("v1")
  category   String?  // InstitutionalTelemetryCategory string, e.g., "adoption", "health"
  properties Json?
  occurredAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, appId])
  @@index([tenantId, eventName])
  @@index([tenantId, category])
  @@index([occurredAt, category])
  @@index([occurredAt])
  @@map("telemetry_records")
}
model MatrizSchemaRelease {
  id        String   @id @default(cuid())
  version   String   @unique
  appliedAt DateTime @default(now())

  @@map("__matriz_schema_releases")
}
