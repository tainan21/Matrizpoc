# Database URLs por app (L1) — POC V1.3 backend real.
# Estratégia: 1 Postgres físico + schemas lógicos por app via `?schema=<app>`.
# Em dev, todas URLs apontam para a mesma instância; só o schema difere.
# Extração futura (um app→repo próprio) mantém a mesma forma, mas aponta
# para instância separada — zero mudança de código.
#
# Exemplo local (Docker Compose ou Neon/Vercel Postgres shared):
#   DATABASE_URL="postgresql://user:pass@localhost:5432/matriz"
#   CORE_DATABASE_URL="postgresql://user:pass@localhost:5432/matriz?schema=core"
#   HUB_DATABASE_URL="postgresql://user:pass@localhost:5432/matriz?schema=hub"
#   ...

DATABASE_URL="postgresql://user:pass@localhost:5432/matriz"
CORE_DATABASE_URL="postgresql://user:pass@localhost:5432/matriz?schema=core"
HUB_DATABASE_URL="postgresql://user:pass@localhost:5432/matriz?schema=hub"
SPOT_DATABASE_URL="postgresql://user:pass@localhost:5432/matriz?schema=spot"
SEUMEI_DATABASE_URL="postgresql://user:pass@localhost:5432/matriz?schema=seumei"
CONTRACTS_DATABASE_URL="postgresql://user:pass@localhost:5432/matriz?schema=contracts"
WILLDASH_DATABASE_URL="postgresql://user:pass@localhost:5432/matriz?schema=willdash"
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_DEPLOY_HOOK_MATRIZ_HUB=
VERCEL_DEPLOY_HOOK_SPOT=
VERCEL_DEPLOY_HOOK_SEUMEI=
VERCEL_DEPLOY_HOOK_CONTRACTS=
VERCEL_DEPLOY_HOOK_WILLDASH=
SPLIT_REPO_PAT=

# Matriz Workbench — local-only. Use a unique value with at least 16 chars.
WORKBENCH_LOCAL_TOKEN=
# Optional override when the process cannot infer the monorepo root.
MATRIZ_REPO_ROOT=
