{
  "name": "@matriz/design-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./primitives": "./src/primitives.tsx",
    "./styles.css": "./src/utility-shim.css",
    "./metadata": "./src/metadata.ts",
    "./sounds": "./src/sounds/index.ts"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build && pnpm run check-storybook-runtime",
    "check-storybook-runtime": "node ./scripts/check-storybook-runtime.mjs",
    "typecheck": "tsc --noEmit && pnpm run typecheck:mdx",
    "typecheck:mdx": "node ./scripts/check-storybook-mdx.mjs",
    "lint": "eslint src .storybook stories scripts",
    "test": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/react-vite": "10.5.8",
    "@mdx-js/mdx": "3.1.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "30.0.1",
    "storybook": "10.5.8",
    "storybook-addon-pseudo-states": "10.5.8",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@matriz/design-system": "workspace:^",
    "@matriz/foundation-constants": "workspace:^",
    "@matriz/foundation-utils": "workspace:^",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  }
}
