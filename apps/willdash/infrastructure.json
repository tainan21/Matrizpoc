{
  "schemaVersion": "v1",
  "appId": "willdash",
  "classification": "product",
  "runtime": { "kind": "web", "port": 3004, "healthPath": "/api/health" },
  "database": { "required": true, "schema": "willdash", "tenancy": "tenant", "runtimeRole": "matriz_willdash_runtime", "migrationRole": "matriz_willdash_migration", "prismaSchema": "prisma/willdash/schema.prisma" },
  "identity": { "required": true, "oidcClientId": "willdash", "callbackPath": "/api/auth/oidc/callback" },
  "cache": { "required": false, "namespaces": [] },
  "events": { "transport": "nats-jetstream", "outbox": true, "inbox": true },
  "environment": { "keys": [
    { "name": "WILLDASH_DATABASE_URL", "secret": true, "required": true, "source": "control-vault" },
    { "name": "MATRIZ_IDENTITY_ISSUER", "secret": false, "required": true, "source": "generated" },
    { "name": "WILLDASH_OIDC_CLIENT_ID", "secret": false, "required": true, "source": "generated" },
    { "name": "WILLDASH_OIDC_CALLBACK_URL", "secret": false, "required": true, "source": "generated" },
    { "name": "WILLDASH_OIDC_CLIENT_SECRET", "secret": true, "required": true, "source": "control-vault" },
    { "name": "WILLDASH_SESSION_SECRET", "secret": true, "required": true, "source": "control-vault" }
  ] },
  "filesystem": { "required": false }
}
