{
  "schemaVersion": "v1",
  "appId": "matriz-pay",
  "classification": "platform",
  "runtime": { "kind": "web", "port": 3012, "healthPath": "/api/health" },
  "database": { "required": true, "schema": "pay", "tenancy": "global-user", "runtimeRole": "matriz_pay_runtime", "migrationRole": "matriz_pay_migration", "prismaSchema": "prisma/pay/schema.prisma" },
  "identity": { "required": true, "oidcClientId": "matriz-pay", "callbackPath": "/api/auth/oidc/callback" },
  "cache": { "required": false, "namespaces": [] },
  "events": { "transport": "nats-jetstream", "outbox": true, "inbox": false },
  "environment": { "keys": [
    { "name": "PAY_DATABASE_URL", "secret": true, "required": true, "source": "control-vault" },
    { "name": "MATRIZ_IDENTITY_ISSUER", "secret": false, "required": true, "source": "generated" },
    { "name": "PAY_OIDC_CLIENT_ID", "secret": false, "required": true, "source": "generated" },
    { "name": "PAY_OIDC_CALLBACK_URL", "secret": false, "required": true, "source": "generated" },
    { "name": "PAY_OIDC_CLIENT_SECRET", "secret": true, "required": true, "source": "control-vault" },
    { "name": "PAY_SESSION_SECRET", "secret": true, "required": true, "source": "control-vault" }
  ] },
  "filesystem": { "required": false }
}
