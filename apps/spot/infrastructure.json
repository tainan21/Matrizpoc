{
  "schemaVersion": "v1",
  "appId": "spot",
  "classification": "product",
  "runtime": { "kind": "web", "port": 3001, "healthPath": "/api/health" },
  "database": { "required": true, "schema": "spot", "tenancy": "tenant", "runtimeRole": "matriz_spot_runtime", "migrationRole": "matriz_spot_migration", "prismaSchema": "prisma/spot/schema.prisma" },
  "identity": { "required": true, "oidcClientId": "spot", "callbackPath": "/api/auth/oidc/callback" },
  "cache": { "required": false, "namespaces": [] },
  "events": { "transport": "nats-jetstream", "outbox": true, "inbox": true },
  "environment": { "keys": [
    { "name": "SPOT_DATABASE_URL", "secret": true, "required": true, "source": "control-vault" },
    { "name": "MATRIZ_IDENTITY_ISSUER", "secret": false, "required": true, "source": "generated" },
    { "name": "SPOT_OIDC_CLIENT_ID", "secret": false, "required": true, "source": "generated" },
    { "name": "SPOT_OIDC_CALLBACK_URL", "secret": false, "required": true, "source": "generated" },
    { "name": "SPOT_OIDC_CLIENT_SECRET", "secret": true, "required": true, "source": "control-vault" },
    { "name": "SPOT_SESSION_SECRET", "secret": true, "required": true, "source": "control-vault" }
  ] },
  "filesystem": { "required": false }
}
