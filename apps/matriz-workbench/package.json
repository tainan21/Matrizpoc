{
  "name": "@matriz/app-matriz-workbench",
  "version": "0.1.0",
  "private": true,
  "main": "dist/native-desktop/main.js",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3005",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3005",
    "lint": "eslint app src proxy.ts public-contract.ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts --no-file-parallelism",
    "health": "tsx src/cli/health.ts",
    "sync": "tsx src/cli/sync.ts",
    "sync:planning": "tsx src/cli/sync-planning-model.ts",
    "import:backlog-batch": "tsx src/cli/import-backlog-batch.ts",
    "materialize:matriz-program": "tsx src/cli/materialize-matriz-program.ts",
    "sync:federated-evidence": "tsx src/cli/sync-federated-plan-evidence.ts",
    "verify:mcp": "tsx src/cli/verify-mcp.ts",
    "mcp": "tsx src/mcp/server.ts",
    "desktop:compile": "tsc -p tsconfig.desktop.json",
    "desktop:prepare": "pnpm run build && pnpm run desktop:compile && tsx scripts/prepare-desktop-runtime.ts",
    "desktop:package": "pnpm run desktop:prepare && electron-builder --config electron-builder.config.cjs --win nsis --x64",
    "desktop:release": "tsx scripts/assert-release-signing.ts && pnpm run desktop:package && tsx scripts/generate-release-manifest.ts"
  },
  "dependencies": {
    "@matriz/design-system": "workspace:*",
    "@matriz/flows-ecosystem": "workspace:^",
    "@matriz/flows-praticies": "workspace:^",
    "@matriz/platform-storage": "workspace:^",
    "@matriz/foundation-types": "workspace:*",
    "@matriz/integration-api-contracts": "workspace:*",
    "@matriz/integration-registry-core": "workspace:*",
    "@matriz/platform-config": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "electron-updater": "6.8.9",
    "next": "16.2.12",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.7.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.2",
    "jsdom": "30.0.1",
    "electron": "37.2.5",
    "electron-builder": "26.0.12"
  }
}
