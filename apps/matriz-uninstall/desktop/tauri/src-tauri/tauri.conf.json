{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matriz Uninstall Tauri",
  "version": "0.1.0",
  "identifier": "com.matriz.uninstall.tauri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Matriz Uninstall Tauri",
        "width": 1240,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://github.com https://*.githubusercontent.com http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../../../matriz-ops/desktop/src-tauri/icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
