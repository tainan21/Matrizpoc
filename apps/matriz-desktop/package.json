{
  "name": "@matriz/app-matriz-desktop",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "build:native": "tauri build --no-bundle",
    "package:binary": "tauri build --bundles nsis",
    "package": "pwsh -NoProfile -File ./scripts/package-matriz-control.ps1",
    "package:update": "pwsh -NoProfile -File ./scripts/package-signed-update.ps1",
    "acceptance:inspect": "pwsh -NoProfile -File ./acceptance/windows/matriz-control-acceptance.ps1 -Mode Inspect",
    "acceptance:plan:package": "pwsh -NoProfile -File ./acceptance/windows/matriz-control-acceptance.ps1 -Mode Package -PlanOnly",
    "acceptance:plan:installed": "pwsh -NoProfile -File ./acceptance/windows/matriz-control-acceptance.ps1 -Mode Installed -PlanOnly",
    "acceptance:installed": "pwsh -NoProfile -File ./acceptance/windows/matriz-control-acceptance.ps1 -Mode Installed",
    "e2e:build": "tauri build --no-bundle",
    "e2e:run": "playwright test --config ./playwright.config.ts",
    "e2e": "corepack pnpm run e2e:build && corepack pnpm run e2e:run",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint src acceptance public-contract.ts --max-warnings 0",
    "tauri": "tauri"
  },
  "dependencies": {
    "@matriz/design-system": "workspace:^",
    "@matriz/design-ui": "workspace:*",
    "@matriz/integration-api-contracts": "workspace:*",
    "@matriz/integration-registry-core": "workspace:*",
    "@matriz/platform-config": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.7.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.3.4",
    "@playwright/test": "1.62.1",
    "eslint": "9.12.0",
    "jsdom": "30.0.1",
    "tsx": "4.22.4",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.2"
  }
}
