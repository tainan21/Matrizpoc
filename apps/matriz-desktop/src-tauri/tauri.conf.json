{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matriz Control",
  "version": "1.1.0",
  "identifier": "com.matriz.control",
  "build": {
    "beforeDevCommand": "corepack pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Matriz Control",
        "width": 540,
        "height": 720,
        "minWidth": 420,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Matriz",
    "copyright": "Copyright © 2026 Matriz",
    "category": "DeveloperTool",
    "shortDescription": "Controle local do ecossistema Matriz",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
