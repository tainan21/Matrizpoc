{
  "name": "@matriz/app-seumei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3008",
    "build": "next build",
    "start": "next start -p 3008",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "demo:provision": "tsx scripts/provision-demo.ts",
    "desktop:compile": "tsc --project desktop/tsconfig.json",
    "desktop:prepare": "pnpm run desktop:compile && tsx scripts/prepare-desktop-shell.ts",
    "desktop:dev": "pnpm run desktop:compile && pnpm exec electron desktop-dist/main.js",
    "desktop:package": "pnpm run desktop:prepare && pnpm exec electron-builder --config desktop/electron-builder.yml --win nsis --x64",
    "desktop:verify-signing": "tsx scripts/verify-desktop-signing.ts",
    "desktop:release-manifest": "tsx scripts/create-desktop-release-manifest.ts",
    "desktop:release": "pnpm run desktop:verify-signing && pnpm run desktop:package && pnpm run desktop:release-manifest"
  },
  "dependencies": {
    "@matriz/access-tenants": "workspace:*",
    "@matriz/design-system": "workspace:*",
    "@matriz/design-ui": "workspace:*",
    "@matriz/flows-auth": "workspace:*",
    "@matriz/flows-ecosystem": "workspace:*",
    "@matriz/flows-onboarding": "workspace:*",
    "@matriz/foundation-types": "workspace:*",
    "@matriz/integration-api-contracts": "workspace:*",
    "@matriz/integration-events": "workspace:*",
    "@matriz/integration-manifests": "workspace:*",
    "@matriz/integration-registry-core": "workspace:*",
    "@matriz/platform-auth": "workspace:*",
    "@matriz/platform-config": "workspace:*",
    "@matriz/platform-db": "workspace:*",
    "next": "16.2.12",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.7.5",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "jsdom": "30.0.1",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.2",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
