{
  "schemaVersion": "v1",
  "appId": "matriz-hub",
  "classification": "platform",
  "runtime": { "kind": "web", "port": 3000, "healthPath": "/api/health" },
  "database": { "required": true, "schema": "hub", "tenancy": "tenant", "runtimeRole": "matriz_hub_runtime", "migrationRole": "matriz_hub_migration", "prismaSchema": "prisma/hub/schema.prisma" },
  "identity": { "required": true, "oidcClientId": "matriz-hub", "callbackPath": "/api/auth/oidc/callback" },
  "cache": { "required": true, "namespaces": ["ecosystem", "docs"], "defaultTtlSeconds": 300 },
  "events": { "transport": "nats-jetstream", "outbox": true, "inbox": true },
  "environment": { "keys": [
    { "name": "HUB_DATABASE_URL", "secret": true, "required": true, "source": "control-vault" },
    { "name": "MATRIZ_IDENTITY_ISSUER", "secret": false, "required": true, "source": "generated" },
    { "name": "HUB_OIDC_CLIENT_ID", "secret": false, "required": true, "source": "generated" },
    { "name": "HUB_OIDC_CALLBACK_URL", "secret": false, "required": true, "source": "generated" },
    { "name": "CACHE_URL", "secret": false, "required": true, "source": "generated" },
    { "name": "HUB_CACHE_USERNAME", "secret": false, "required": true, "source": "generated" },
    { "name": "HUB_CACHE_PASSWORD", "secret": true, "required": true, "source": "control-vault" },
    { "name": "HUB_CACHE_DEFAULT_TTL_SECONDS", "secret": false, "required": true, "source": "generated" },
    { "name": "HUB_OIDC_CLIENT_SECRET", "secret": true, "required": true, "source": "control-vault" },
    { "name": "HUB_SESSION_SECRET", "secret": true, "required": true, "source": "control-vault" },
    { "name": "CLIENT_ADMIN_VERCEL_TOKEN", "secret": true, "required": false, "source": "control-vault" },
    { "name": "CLIENT_ADMIN_VERCEL_TEAM_ID", "secret": false, "required": false, "source": "operator" },
    { "name": "CLIENT_ADMIN_VERCEL_PROJECT_IDS", "secret": false, "required": false, "source": "operator" },
    { "name": "CLIENT_ADMIN_GA4_PROPERTY_ID", "secret": false, "required": false, "source": "operator" },
    { "name": "CLIENT_ADMIN_GA4_ACCESS_TOKEN", "secret": true, "required": false, "source": "control-vault" }
  ] },
  "filesystem": { "required": false }
}
