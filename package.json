{
  "name": "matriz",
  "version": "0.1.0",
  "private": true,
  "description": "Matriz Monorepo POC V1 — multi-app ecosystem with shared packages, manifests, registry, external links and event bus.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build --concurrency=4",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint --concurrency=4",
    "typecheck": "turbo run typecheck --concurrency=4",
    "clean": "turbo run clean && rm -rf node_modules",
    "prisma:validate": "pnpm prisma:validate:core && pnpm prisma:validate:hub && pnpm prisma:validate:spot && pnpm prisma:validate:seumei && pnpm prisma:validate:contracts && pnpm prisma:validate:willdash",
    "prisma:validate:core": "prisma validate --schema prisma/schemas/core.prisma",
    "prisma:validate:hub": "prisma validate --schema prisma/schemas/hub.prisma",
    "prisma:validate:spot": "prisma validate --schema prisma/schemas/spot.prisma",
    "prisma:validate:seumei": "prisma validate --schema prisma/schemas/seumei.prisma",
    "prisma:validate:contracts": "prisma validate --schema prisma/schemas/contracts.prisma",
    "prisma:validate:willdash": "prisma validate --schema prisma/schemas/willdash.prisma",
    "prisma:generate": "pnpm prisma:generate:core && pnpm prisma:generate:hub && pnpm prisma:generate:seumei && pnpm prisma:generate:contracts",
    "prisma:generate:core": "prisma generate --schema prisma/schemas/core.prisma",
    "prisma:generate:hub": "prisma generate --schema prisma/schemas/hub.prisma",
    "prisma:generate:seumei": "prisma generate --schema prisma/schemas/seumei.prisma",
    "prisma:generate:contracts": "prisma generate --schema prisma/schemas/contracts.prisma",
    "test:smoke": "vitest run --config vitest.config.ts",
    "test:smoke:watch": "vitest --config vitest.config.ts",
    "demo:flows": "tsx scripts/demo-flows.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.8.1",
    "@typescript-eslint/parser": "8.8.1",
    "eslint": "9.12.0",
    "next": "16.2.4",
    "prettier": "3.3.3",
    "prisma": "5.20.0",
    "tsx": "4.19.1",
    "turbo": "2.1.3",
    "typescript": "5.6.3",
    "vitest": "2.1.2"
  },
  "engines": {
    "node": "22.x",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "react": "19.2.0",
      "react-dom": "19.2.0"
    }
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3"
  }
}
