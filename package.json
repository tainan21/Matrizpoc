{
  "name": "matriz",
  "version": "0.1.0",
  "private": true,
  "description": "Matriz Monorepo POC V1 — multi-app ecosystem with shared packages, manifests, registry, external links and event bus.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build --concurrency=1",
    "dev": "turbo run dev --parallel",
    "app": "tsx tooling/project-factory/cli.ts",
    "dev:hub": "pnpm app dev hub",
    "dev:spot": "pnpm app dev spot",
    "dev:seumei": "pnpm app dev seumei",
    "dev:contracts": "pnpm app dev contracts",
    "dev:willdash": "pnpm app dev willdash",
    "dev:workbench": "pnpm app dev workbench",
    "dev:sites": "pnpm app dev sites",
    "ops:bootstrap-owner": "tsx tooling/scripts/bootstrap-ops-owner.ts",
    "ops:seed-e2e": "tsx tooling/scripts/seed-ops-e2e.ts",
    "test:factory": "vitest run --config tooling/project-factory/vitest.config.ts",
    "lint": "turbo run lint --concurrency=4",
    "typecheck": "turbo run typecheck --concurrency=4",
    "clean": "turbo run clean && rm -rf node_modules",
    "prisma:validate": "pnpm prisma:validate:core && pnpm prisma:validate:hub && pnpm prisma:validate:spot && pnpm prisma:validate:seumei && pnpm prisma:validate:contracts && pnpm prisma:validate:willdash && pnpm prisma:validate:ops && pnpm prisma:validate:pay",
    "prisma:validate:core": "prisma validate --schema prisma/core/schema.prisma",
    "prisma:validate:hub": "prisma validate --schema prisma/hub/schema.prisma",
    "prisma:validate:spot": "prisma validate --schema prisma/spot/schema.prisma",
    "prisma:validate:seumei": "prisma validate --schema prisma/seumei/schema.prisma",
    "prisma:validate:contracts": "prisma validate --schema prisma/contracts/schema.prisma",
    "prisma:validate:willdash": "prisma validate --schema prisma/willdash/schema.prisma",
    "prisma:validate:ops": "prisma validate --schema prisma/ops/schema.prisma",
    "prisma:validate:pay": "prisma validate --schema prisma/pay/schema.prisma",
    "prisma:generate": "pnpm prisma:generate:core && pnpm prisma:generate:hub && pnpm prisma:generate:spot && pnpm prisma:generate:seumei && pnpm prisma:generate:contracts && pnpm prisma:generate:willdash && pnpm prisma:generate:ops && pnpm prisma:generate:pay",
    "prisma:generate:core": "prisma generate --schema prisma/core/schema.prisma",
    "prisma:generate:hub": "prisma generate --schema prisma/hub/schema.prisma",
    "prisma:generate:spot": "prisma generate --schema prisma/spot/schema.prisma",
    "prisma:generate:seumei": "prisma generate --schema prisma/seumei/schema.prisma",
    "prisma:generate:contracts": "prisma generate --schema prisma/contracts/schema.prisma",
    "prisma:generate:willdash": "prisma generate --schema prisma/willdash/schema.prisma",
    "prisma:generate:ops": "prisma generate --schema prisma/ops/schema.prisma",
    "prisma:generate:pay": "prisma generate --schema prisma/pay/schema.prisma",
    "prisma:migrate:deploy": "tsx tooling/scripts/migration-matrix.ts deploy",
    "prisma:migrate:test": "tsx tooling/scripts/migration-matrix.ts test",
    "prisma:migrate:drift": "tsx tooling/scripts/migration-matrix.ts drift",
    "neon:topology:dry-run": "tsx infrastructure/neon/cli.ts --dry-run",
    "neon:topology:verify": "tsx infrastructure/neon/cli.ts --verify",
    "neon:topology:apply": "tsx infrastructure/neon/cli.ts --apply",
    "next:typegen": "pnpm --filter \"./apps/*\" exec next typegen",
    "test:apps": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "test:smoke": "vitest run --config vitest.config.ts",
    "test:smoke:watch": "vitest --config vitest.config.ts",
    "audit:prod": "tsx tooling/scripts/audit-production.ts",
    "verify:boundaries": "tsx tooling/scripts/verify-app-boundaries.ts",
    "verify:infrastructure": "tsx tooling/scripts/verify-infrastructure-contracts.ts",
    "verify:tracked-artifacts": "tsx tooling/scripts/verify-tracked-artifacts.ts",
    "build:affected": "turbo run build --affected --concurrency=4",
    "check:clean": "git diff --exit-code && git diff --cached --exit-code",
    "demo:flows": "tsx scripts/demo-flows.ts",
    "demo:docs": "tsx scripts/seed-matrizdocs-demo.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.8.1",
    "@typescript-eslint/parser": "8.8.1",
    "eslint": "9.12.0",
    "next": "16.2.12",
    "prettier": "3.3.3",
    "prisma": "5.20.0",
    "tsx": "4.19.1",
    "turbo": "2.10.10",
    "typescript": "5.6.3",
    "vitest": "2.1.2"
  },
  "engines": {
    "node": "22.x",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "js-yaml": "5.4.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.26",
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "sharp": "0.35.3"
    }
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3"
  }
}
