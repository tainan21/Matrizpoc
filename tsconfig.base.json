{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Matriz Base",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "paths": {
      "@matriz/design-ui": ["./packages/design/ui/src/index.ts"],
      "@matriz/design-ui/*": ["./packages/design/ui/src/*"],
      "@matriz/design-system": ["./packages/design/system/src/index.ts"],
      "@matriz/design-system/*": ["./packages/design/system/src/*"],
      "@matriz/platform-auth": ["./packages/platform/auth/src/index.ts"],
      "@matriz/platform-auth/v1": ["./packages/platform/auth/src/v1/index.ts"],
      "@matriz/platform-storage": ["./packages/platform/storage/src/index.ts"],
      "@matriz/platform-notifications": ["./packages/platform/notifications/src/index.ts"],
      "@matriz/platform-telemetry": ["./packages/platform/telemetry/src/index.ts"],
      "@matriz/platform-pdf": ["./packages/platform/pdf/src/index.ts"],
      "@matriz/platform-config": ["./packages/platform/config/src/index.ts"],
      "@matriz/platform-i18n": ["./packages/platform/i18n/src/index.ts"],
      "@matriz/platform-env": ["./packages/platform/env/src/index.ts"],
      "@matriz/access-tenants": ["./packages/access/tenants/src/index.ts"],
      "@matriz/access-permissions": ["./packages/access/permissions/src/index.ts"],
      "@matriz/integration-events": ["./packages/integration/events/src/index.ts"],
      "@matriz/integration-registry-core": ["./packages/integration/registry-core/src/index.ts"],
      "@matriz/integration-manifests": ["./packages/integration/manifests/src/index.ts"],
      "@matriz/integration-external-links": ["./packages/integration/external-links/src/index.ts"],
      "@matriz/integration-api-contracts": ["./packages/integration/api-contracts/src/index.ts"],
      "@matriz/integration-api-contracts/*": ["./packages/integration/api-contracts/src/*"],
      "@matriz/flows-onboarding": ["./packages/flows/onboarding/src/index.ts"],
      "@matriz/foundation-types": ["./packages/foundation/types/src/index.ts"],
      "@matriz/foundation-utils": ["./packages/foundation/utils/src/index.ts"],
      "@matriz/foundation-constants": ["./packages/foundation/constants/src/index.ts"],
      "@matriz/foundation-schemas": ["./packages/foundation/schemas/src/index.ts"],
      "@apps/matriz-hub/public-contract": ["./apps/matriz-hub/public-contract.ts"],
      "@apps/spot/public-contract": ["./apps/spot/public-contract.ts"],
      "@apps/seumei/public-contract": ["./apps/seumei/public-contract.ts"],
      "@apps/contracts/public-contract": ["./apps/contracts/public-contract.ts"],
      "@apps/willdash/public-contract": ["./apps/willdash/public-contract.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}
